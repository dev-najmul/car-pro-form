# The Maps/Places browser key is delivered to the browser. Restrict it to your
# permitted website referrers and Maps JavaScript API + Places API (New).
# Optional browser-only routing also needs Routes API on this key.
# The temporary Pages backend instead uses the separate server key below.
GOOGLE_MAPS_BROWSER_KEY=

# Keep this separate key server-side and restrict it to Routes API/server access.
GOOGLE_ROUTES_API_KEY=
